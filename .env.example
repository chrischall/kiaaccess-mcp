# Kia Owners / Kia Access account credentials.
# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
# NOTE: Kia counts failed logins (`loginAttempt` in the auth response) and
# escalates to reCAPTCHA after repeated failures, so a typo here costs more
# than a retry — double-check before the first run.
KIA_USERNAME=you@example.com
KIA_PASSWORD=

# Optional. Vehicle-command gate:
#   none    — no command tools registered
#   comfort — climate + charging only (default)
#   all     — also registers door lock/unlock
KIA_WRITE_MODE=comfort

# Optional. Stable device UUID for the app login handshake.
# Generated and cached under ~/.kiaaccess-mcp/ when omitted.
KIA_DEVICE_ID=

# Optional. A remember-me token from a completed MFA bootstrap elsewhere (copy
# `rmtoken` out of that machine's ~/.kiaaccess-mcp/session.json). Set it and the one-time bootstrap is skipped
# entirely — this is how a hosted deployment with no phone to read an OTP on
# gets a session. It is a CREDENTIAL: with the password it grants full control
# of the vehicle. It takes precedence over any token in the session store, and
# it is bound to the device uuid it was minted against, so set KIA_DEVICE_ID to
# the SAME value that was in effect during the bootstrap.
KIA_RMTOKEN=

# Optional. Per-request deadline for Kia API calls, in milliseconds (default
# 30000). A request that takes longer is abandoned; for a vehicle command the
# result then says whether it reached Kia is unknown, so re-read before re-sending.
KIA_REQUEST_TIMEOUT_MS=
