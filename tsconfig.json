{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  // `src/worker.ts` is the Cloudflare entry point. It is built by wrangler (esbuild
  // against the workerd runtime), never by this stdio `tsc` build — leaving it in
  // would emit a `dist/worker.js` that Node cannot load and that the npm package
  // has no use for. Its type-checking happens via `wrangler deploy`/`wrangler dev`.
  "exclude": ["node_modules", "dist", "src/worker.ts"]
}
